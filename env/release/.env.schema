# Infisical supplies credentials for the release command only.
# @defaultRequired=false
# @defaultSensitive=true
# @cache=disabled
# ---

# Loader authentication stays out of application and build processes.
# @type=string @internal
INFISICAL_TOKEN=
# @type=string @internal
INFISICAL_CLIENT_ID=
# @type=string @internal
INFISICAL_CLIENT_SECRET=
# @type=string @internal
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# @type=string @internal
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# @type=string @internal
INFISICAL_UNIVERSAL_AUTH_ACCESS_TOKEN=
# @type=string @internal
OP_TOKEN=
# @type=string @internal
OP_SERVICE_ACCOUNT_TOKEN=
# @type=string @internal
OP_ENVIRONMENT_ID=

# @type=string
NAPS_GSC_CLIENT_SECRET=

# @type=string
NAPS_GSC_REFRESH_TOKEN=

# @type=string
NAPS_GSC_CLIENT_ID=

# @type=string
NAPS_CLI_SIGNING_KEY=

# @type=string
NAPS_CLI_SIGNING_KEY_CONTENT=

# R2 delegation parent, not the REST caller credential. cf uses saved OAuth.
# @type=string
CLOUDFLARE_R2_PARENT_ACCESS_KEY_ID=

# @type=string
CLOUDFLARE_ACCOUNT_ID=

# Strip inherited credentials that this command does not use.
# @type=string @internal
NAPS_CLI_API_KEY=

# @type=string @internal
NAPS_CLI_SEO_API_TOKEN=

# @type=string @internal
NAPS_CLI_REDDIT_API_TOKEN=

# @type=string @internal
NAPS_CLI_TWITTERAPI_TOKEN=

# @type=string @internal
NAPS_CLI_X_BEARER_TOKEN=

# @type=string @internal
NAPS_CLI_TREG_TOKEN=

# @type=string @internal
NAPS_CLI_TREG_ORG=

# @type=string @internal
TREG_TOKEN=

# @type=string @internal
TREG_ORG=

# @type=string @internal
SEO_API_TOKEN=

# @type=string @internal
TWITTERAPI_API_KEY=

# @type=string @internal
X_BEARER_TOKEN=
