# Credentials for the release command only.
# @defaultRequired=false
# @defaultSensitive=true
# @cache=disabled
# @plugin(@varlock/1password-plugin)
# @import(~/.config/varlock/naps-cli/.env.release, pick=[OP_TOKEN, OP_SERVICE_ACCOUNT_TOKEN, OP_ENVIRONMENT_ID, NAPS_GSC_CLIENT_SECRET, NAPS_GSC_REFRESH_TOKEN, NAPS_GSC_CLIENT_ID, NAPS_CLI_SIGNING_KEY, NAPS_CLI_SIGNING_KEY_CONTENT, CLOUDFLARE_R2_PARENT_ACCESS_KEY_ID, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID], allowMissing=true)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, useCliWithServiceAccount=true)
# @setValuesBulk(opLoadEnvironment($OP_ENVIRONMENT_ID), enabled=not(isEmpty($OP_ENVIRONMENT_ID)), pick=[NAPS_GSC_CLIENT_SECRET, NAPS_GSC_REFRESH_TOKEN, NAPS_GSC_CLIENT_ID, NAPS_CLI_SIGNING_KEY, NAPS_CLI_SIGNING_KEY_CONTENT, CLOUDFLARE_R2_PARENT_ACCESS_KEY_ID, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID])
# ---

