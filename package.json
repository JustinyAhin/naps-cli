{
  "name": "napsdotsh-cli",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "naps-cli": "./index.ts"
  },
  "workspaces": [
    "packages/api-clients"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "bun run index.ts",
    "build": "bun run scripts/build.ts",
    "build:host": "bun build ./index.ts --compile --minify --sourcemap=inline --outfile dist/naps-cli && rm -f dist/*.js.map",
    "release": "bun run scripts/release.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:check": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@stricli/auto-complete": "^1.3.0",
    "@stricli/core": "^1.3.0",
    "api-clients": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^6.0.2"
  }
}
